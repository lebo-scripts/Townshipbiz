# GEMINI_API_KEY: Required for server-side Gemini AI receipt OCR, document interpretation, and AI business adviser.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (must be 3000 in AI Studio).
PORT="3000"

# VAULT_STORAGE_DIR: Private directory for uploaded receipts and documents (outside public web root).
VAULT_STORAGE_DIR=".private_storage"

# MAX_UPLOAD_BYTES: Maximum allowed upload size per document or receipt (default 10MB).
MAX_UPLOAD_BYTES="10485760"

# AUTH_TOKEN_SECRET: Secret used for signing local password-reset or auxiliary tokens in tests.
AUTH_TOKEN_SECRET="replace-with-strong-random-32-byte-secret"
